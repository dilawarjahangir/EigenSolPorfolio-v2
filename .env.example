# Public SEO verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# PostgreSQL runtime connection (use a least-privilege application role)
DATABASE_URL=postgresql://application-role:replace-me@127.0.0.1:5432/eigensol_website
DATABASE_SSL=false
# Supply MIGRATION_DATABASE_URL only to the manual migration command; do not expose it to the app.
MIGRATION_DATABASE_URL=

# Admin authentication (server-only)
# Leave ADMIN_EMAIL blank to use CONTACT_TO_EMAIL as the single owner allowlist.
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=EigenSol Owner
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://eigensol.com
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-stable-production-key

# Zoho mail delivery (server-only)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=sender@example.com
ZOHO_SMTP_PASS=replace-with-a-zoho-app-password
CONTACT_FROM_EMAIL=sender@example.com
CONTACT_TO_EMAIL=owner@example.com

# Comment abuse protection (server-only)
COMMENT_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Durable media storage outside release directories
BLOG_MEDIA_ROOT=/es/shared/eigensol-media
