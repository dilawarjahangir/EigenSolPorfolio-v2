[Unit]
Description=EigenSol CMS daily retention maintenance
Documentation=file:///es/eigensol.com/docs/operations/blog-cms.md
Wants=network-online.target
After=network-online.target postgresql.service es_main_site.service
ConditionPathExists=/es/eigensol.com/package.json

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/es/eigensol.com
Environment=NODE_ENV=production
Environment=NPM_CONFIG_UPDATE_NOTIFIER=false
Environment=NPM_CONFIG_CACHE=/tmp/eigensol-npm-cache
Environment=PATH=/root/.nvm/versions/node/v24.18.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=/es/eigensol.com/.env
ExecStart=/root/.nvm/versions/node/v24.18.0/bin/npm run cms:maintenance
TimeoutStartSec=15min
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/es/shared/eigensol-media

[Install]
WantedBy=multi-user.target
